<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7"/>
    </startup>

	<connectionStrings>
		<add name="AyoboDb" connectionString="data source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\AyuboDrive.mdf;Integrated Security=True;Connect Timeout=30" providerName="System.Data.SqlClient"/>
	</connectionStrings>
</configuration>